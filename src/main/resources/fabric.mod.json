{
	"schemaVersion": 1,
	"id": "infinityforge",
	"version": "${version}",
	"accessWidener": "infinityforge.accesswidener",
	"name": "Infinity Forge",
	"description": "This is a mod that adds infinity stones and other cool mechanics to Minecraft 1.20.1",
	"authors": [
		"AlvinAlex"
	],
	"contact": {
		"homepage": "https://github.com/AlvinIsSoCool/infinityforge",
		"sources": "https://github.com/AlvinIsSoCool/infinityforge",
		"issues": "https://github.com/AlvinIsSoCool/infinityforge/issues"
	},
	"license": "MIT",
	"icon": "assets/infinityforge/modicon/modicon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.alvin.infinityforge.InfinityForge"
		],
		"client": [
			"net.alvin.infinityforge.InfinityForgeClient"
		],
		"fabric-datagen": [
			"net.alvin.infinityforge.InfinityForgeDataGenerator"
		],
		"modmenu": [
			"net.alvin.infinityforge.compat.modmenu.InfinityForgeModMenuPlugin"
		],
		"rei_client": [
			"net.alvin.infinityforge.compat.rei.InfinityForgeREIPlugin"
		]
	},
	"mixins": [
		"infinityforge.mixins.json",
		"infinityforge.client.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.6",
		"minecraft": "1.20.1",
		"java": ">=17",
		"fabric-api": ">=0.92.7",
		"yet_another_config_lib_v3": ">=3.6.1"
	},
	"suggests": {
		"iris": ">=1.7.6",
		"roughlyenoughitems": ">=12.1.785",
		"modmenu": ">=7.2.2"
	}
}